; Engine configuration file.
config_version=5

[application]

config/name="Oblitus Limbo"
config/description="Oblitus Limbo — Volume I (Demo). Baseado no livro de ByGuizo."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_signal=0
gdscript/warnings/return_value_discarded=0

[autoload]

Game="*res://scripts/core/game.gd"
Audio="*res://scripts/core/audio.gd"
D="*res://scripts/core/director.gd"
Save="*res://scripts/core/save.gd"

[shader_globals]

toon_shadow={
"type": "color",
"value": Color(0.58, 0.52, 0.75, 1)
}
toon_key={
"type": "float",
"value": 0.15
}
toon_key_col={
"type": "color",
"value": Color(1, 0.96, 0.92, 1)
}
toon_rim_col={
"type": "color",
"value": Color(0.85, 0.82, 1, 1)
}
toon_rim={
"type": "float",
"value": 0.25
}
